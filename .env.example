# =========================================================================
# Research Fact Base — configuration reference. Never commit real keys.
#
# There are three places configuration lives; see docs/DEPLOY_GITHUB_PAGES.md.
# =========================================================================

# --- 1. Website (static, GitHub Pages) — PUBLIC values, baked in at build ---
# Set in .github/workflows/deploy-pages.yml for production. For local dev,
# copy these into .env.local and run `npm run dev`.
NEXT_PUBLIC_SUPABASE_URL=https://zfzydmozafepouflrlxb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_d7HEcptiQQyJPtkWUNBTYA_Xur1u94m
# Repo path on github.io; leave empty locally.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_REPO_URL=https://github.com/learner-agent-sudo/research-fact-base

# --- 2. Edge function (research-api) — set in Supabase → Edge Functions → Secrets
# Listed here for reference only; the function never reads this file.
#   OPENROUTER_API_KEY=
#   GEMINI_API_KEY=
#   ALLOWED_EMAILS=you@example.com
# Optional: FREE_GENERATORS, FREE_CHECKER, PAID_GENERATORS, PAID_CHECKER,
#   FANOUT, RETRIEVAL_TOP_K, MIN_SIMILARITY, GEMINI_EMBEDDING_MODEL

# --- 3. Ingest job (scripts/ingest.mjs) — GitHub Actions secrets, or here
# when running locally with:  node --env-file=.env.local scripts/ingest.mjs
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_CORPUS_FOLDER_ID=
# Optional knobs
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
EMBED_BATCH=16
CHUNK_TARGET_CHARS=2400
CHUNK_OVERLAP_CHARS=300
MAX_FILE_MB=25
