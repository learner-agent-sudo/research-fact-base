# =========================================================================
# Research Fact Base — environment variables
# Copy to `.env.local` and fill in. Never commit real keys.
# =========================================================================

# --- Models: OpenRouter is the single gateway to all models ----------------
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model slugs. VERIFY against https://openrouter.ai/models
FREE_GENERATORS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,qwen/qwen-2.5-72b-instruct:free
# FREE_CHECKER is a comma-separated fallback list, tried in order (free slugs
# come and go, so list a couple). Verify at openrouter.ai/models.
FREE_CHECKER=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free
PAID_GENERATORS=anthropic/claude-3.7-sonnet
PAID_CHECKER=anthropic/claude-3.7-sonnet
# How many generators to fan out to on the free tier (accuracy > latency).
FANOUT=3

# --- Embeddings (Phase 1: RAG over the Google Drive corpus) ----------------
VOYAGE_API_KEY=
# Default is voyage-law-2 (1024 dims, legal-tuned). Keep dims == DB vector(1024).
VOYAGE_MODEL=voyage-law-2
# Retrieval + chunking knobs (optional).
RETRIEVAL_TOP_K=8
CHUNK_TARGET_CHARS=2400
CHUNK_OVERLAP_CHARS=300

# --- Web-search source provider (optional; Tavily by default) --------------
TAVILY_API_KEY=

# --- Supabase (Phase 1: pgvector store + auth + storage) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive corpus ingestion (Phase 1) ------------------------------
# Service-account JSON (stringified) with read access to the corpus folder.
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_CORPUS_FOLDER_ID=

# --- Citation verification (Phase 3) --------------------------------------
# CanLII (Canada): metadata/citator API key.
CANLII_API_KEY=
# CourtListener (US): free API token from courtlistener.com/help/api/rest/.
COURTLISTENER_API_TOKEN=
COURTLISTENER_API_BASE=https://www.courtlistener.com/api/rest/v4

# --- Admin (optional gate for /api/ingest/sync) ---------------------------
# If set, ingestion requires header  x-admin-token: <value>. Unset = open (dev).
ADMIN_TOKEN=

# --- App ------------------------------------------------------------------
APP_URL=http://localhost:3000
